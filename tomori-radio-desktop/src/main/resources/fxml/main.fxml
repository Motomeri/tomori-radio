<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.motomeri.tomoriradio.desktop.controller.MainController"
            stylesheets="@../css/styles.css">
    <top>
        <HBox fx:id="topToolbar" styleClass="toolbar" prefHeight="45">
            <HBox fx:id="buttonGroup" alignment="CENTER_LEFT" spacing="10">
                <Button styleClass="toolbar-btn" onAction="#onHome">
                    <graphic>
                        <ImageView fitHeight="45" fitWidth="45" preserveRatio="true">
                            <Image url="@/images/akari.png"/>
                        </ImageView>
                    </graphic>
                </Button>

                <Button styleClass="toolbar-btn" onAction="#onTracks">
                    <graphic>
                        <ImageView fitHeight="45" fitWidth="45" preserveRatio="true">
                            <Image url="@/images/akari.png"/>
                        </ImageView>
                    </graphic>
                </Button>

                <Button styleClass="toolbar-btn" onAction="#onRequest">
                    <graphic>
                        <ImageView fitHeight="45" fitWidth="45" preserveRatio="true">
                            <Image url="@/images/akari.png"/>
                        </ImageView>
                    </graphic>
                </Button>

                <Button styleClass="toolbar-btn" onAction="#onSettings">
                    <graphic>
                        <ImageView fitHeight="45" fitWidth="45" preserveRatio="true">
                            <Image url="@/images/akari.png"/>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <Label fx:id="trackCountLabel" styleClass="track-count" HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT"/>
        </HBox>>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER" styleClass="main-scroll">
            <StackPane fx:id="background" styleClass="background">
            </StackPane>
            <StackPane fx:id="contentArea" styleClass="content-area">
            </StackPane>
        </ScrollPane>
    </center>

</BorderPane>